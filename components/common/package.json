{
  "private": true,
  "name": "common",
  "description": "Shared code between ed-components.",
  "version": "0.0.0",
  "author": "Benjamin Abel <dev.abel@free.fr> (lyceum.fr)",
  "keywords": [
    "markdown",
    "web-component"
  ],
  "type": "module",
  "dependencies": {
    "micromark": "catalog:",
    "micromark-extension-directive": "^3.0.0",
    "micromark-extension-gfm": "catalog:",
    "micromark-extension-math": "catalog:"
  },
  "devDependencies": {
    "@open-wc/testing": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@types/jest": "catalog:",
    "@web/dev-server-esbuild": "catalog:",
    "@web/dev-server-rollup": "catalog:",
    "@web/test-runner": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./dist/src/common.js"
  },
  "license": "MIT",
  "main": "dist/src/common.js",
  "module": "dist/src/common.js",
  "repository": "https://github.com/ed-components/ed-components",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .ts,.html . --ignore-path .gitignore",
    "start": "tsc && tsc --watch --preserveWatchOutput",
    "test": "cd .. && npm run test -- --group $npm_package_name",
    "test:watch": "cd .. && npm run test -- --watch --group $npm_package_name"
  }
}
