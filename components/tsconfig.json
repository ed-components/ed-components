{
  "compilerOptions": {
    "declarationDir": "dist/dts",
    "outDir": "dist/esm",
    // Best pratcice? https://justinfagnani.com/2019/11/01/how-to-publish-web-components-to-npm/
    // es2018 at least: regexps use named capturing groups
    "target": "es2018",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["DOM", "ES2018"],
    "declaration": true,
    "importHelpers": true,
    "declarationMap": true,
    // type checks replace linting
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // global types are not loaded by default since TypeScript 6
    "types": ["mocha"],
    // Skip typechecking libraries and .d.ts files
    "skipLibCheck": true
  }
}
