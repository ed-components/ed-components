{
  "private": true,
  "name": "ed-ans",
  "description": "A webcomponent for sentences answers in education.",
  "version": "0.0.0",
  "author": "Benjamin Abel <dev.abel@free.fr> (lyceum.fr)",
  "keywords": [
    "nlp",
    "web-component"
  ],
  "type": "module",
  "customElements": "custom-elements.json",
  "dependencies": {
    "wink-eng-lite-web-model": "catalog:",
    "wink-nlp": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@open-wc/testing": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-replace": "catalog:",
    "@types/jest": "catalog:",
    "@web/dev-server-esbuild": "catalog:",
    "@web/dev-server-rollup": "catalog:",
    "@web/test-runner": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ed-ans.js": "./dist/ed-ans.js"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "analyze": "cem analyze --globs \"src/Ed*.ts\"",
    "build": "tsc && npm run analyze",
    "prepublish": "tsc && npm run analyze",
    "start": "tsc && ../../node_modules/.bin/concurrently -n $npm_package_name: -k \"tsc --watch --preserveWatchOutput\" \"npm run analyze -- --watch\"",
    "test": "cd .. && npm run test -- --group $npm_package_name",
    "test:watch": "cd .. && npm run test -- --watch --group $npm_package_name"
  }
}