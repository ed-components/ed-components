{
  "private": true,
  "name": "ed-speech",
  "description": "A webcomponent for speech to text answers, transcribed in the browser with Whisper.",
  "version": "0.0.0",
  "author": "Benjamin Abel <dev.abel@free.fr> (lyceum.fr)",
  "keywords": [
    "speech-recognition",
    "whisper",
    "web-component"
  ],
  "type": "module",
  "customElements": "custom-elements.json",
  "dependencies": {
    "common": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ed-speech.js": "./dist/ed-speech.js"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "analyze": "cem analyze --globs \"src/Ed*.ts\"",
    "build": "tsc && npm run analyze",
    "prepublish": "tsc && npm run analyze",
    "start": "tsc && ../../node_modules/.bin/concurrently -n $npm_package_name: -k \"tsc --watch --preserveWatchOutput\" \"npm run analyze -- --watch\"",
    "test": "cd .. && npm run test -- --group $npm_package_name",
    "test:watch": "cd .. && npm run test -- --watch --group $npm_package_name"
  }
}
