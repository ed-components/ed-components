{
  "name": "@ed-components/ed-components",
  "description": "A set of web-components for education.",
  "version": "0.3.0",
  "author": {
    "name": "Benjamin Abel",
    "email": "dev.abel@free.fr"
  },
  "keywords": [
    "ed-tech",
    "web-components"
  ],
  "type": "module",
  "bugs": "https://github.com/ed-components/ed-components/issues",
  "dependencies": {
    "lit": "catalog:",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm-task-list-item": "catalog:",
    "mdast-util-math": "catalog:",
    "micromark": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "micromark-extension-gfm-task-list-item": "catalog:",
    "micromark-extension-math": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@open-wc/testing": "catalog:",
    "@types/mdast": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/mocha": "catalog:",
    "@web/dev-server-esbuild": "catalog:",
    "@web/dev-server-rollup": "catalog:",
    "@web/test-runner": "catalog:",
    "rollup": "^4.66.0",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./ed-components": {
      "types": "./dist/dts/ed-components.d.ts",
      "default": "./dist/esm/ed-components.js"
    },
    "./i18n": {
      "types": "./dist/dts/common/src/i18n.d.ts",
      "default": "./dist/esm/common/src/i18n.js"
    },
    "./emd": {
      "types": "./dist/dts/common/src/emd.d.ts",
      "default": "./dist/esm/common/src/emd.js"
    },
    "./common.js": {
      "types": "./dist/dts/common/src/index.d.ts",
      "default": "./dist/esm/common/src/index.js"
    },
    "./ed-choice": {
      "types": "./dist/dts/ed-choice/src/ed-choice.d.ts",
      "default": "./dist/esm/ed-choice/src/ed-choice.js"
    },
    "./ed-micro": {
      "types": "./dist/dts/ed-micro/src/ed-micro.d.ts",
      "default": "./dist/esm/ed-micro/src/ed-micro.js"
    },
    "./ed-num": {
      "types": "./dist/dts/ed-num/src/ed-num.d.ts",
      "default": "./dist/esm/ed-num/src/ed-num.js"
    },
    "./ed-pb": {
      "types": "./dist/dts/ed-pb/src/ed-pb.d.ts",
      "default": "./dist/esm/ed-pb/src/ed-pb.js"
    },
    "./ed-speech": {
      "types": "./dist/dts/ed-speech/src/ed-speech.d.ts",
      "default": "./dist/esm/ed-speech/src/ed-speech.js"
    },
    "./ed-survey": {
      "types": "./dist/dts/ed-survey/src/ed-survey.d.ts",
      "default": "./dist/esm/ed-survey/src/ed-survey.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/**/*.js",
    "dist/dts/*.d.ts",
    "dist/dts/**/*.d.ts",
    "CHANGELOG.md"
  ],
  "homepage": "https://components.lyceum.fr",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ed-components/ed-components.git",
    "directory": "components"
  },
  "scripts": {
    "analyze": "for comp in ed-*/;do comp=$(basename $comp) && echo \"Analyze $comp\"  && cem analyze --litelement --outdir $comp/ --globs $comp/src/Ed*.ts;done",
    "build": "tsc && rollup -c",
    "lint": "tsc --noEmit",
    "test": "wtr --coverage",
    "test:watch": "wtr --watch"
  },
  "sideEffects": [
    "./dist/ed-components.js",
    "./dist/esm/ed-components.js",
    "./dist/esm/*/src/ed-*.js"
  ],
  "types": "dist/index.d.ts",
  "customElements": "ed-survey/custom-elements.json"
}
