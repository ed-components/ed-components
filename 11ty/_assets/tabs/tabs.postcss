/* from https://github.com/argyleink/gui-challenges/blob/main/tabs/app/css/tabs.css */
snap-tabs {
  --accent: var(--brand-hsl);
  --indicator-size: 2px;

  display: flex;
  flex-direction: column;

  /* no overflow here: it would break position: sticky in the panels */
  position: relative;

  & :matches(header, nav, section, article, a) {
    outline-color: hsl(var(--accent));
    outline-offset: -5px;
  }
}

.scroll-snap-x {
  overflow: auto hidden;
  overscroll-behavior-x: contain;
  scroll-snap-type: x mandatory;

  @media (--motionOK) {
    scroll-behavior: smooth;
  }

  @media (hover: none) {
    scrollbar-width: none;

    &::-webkit-scrollbar {
      width: 0;
      height: 0;
    }
  }
}

snap-tabs > header {
  --text-color: var(--text-2);
  --text-active-color: var(--text-1);

  flex-shrink: 0;
  min-block-size: fit-content;

  display: flex;
  flex-direction: column;

  & > nav {
    display: flex;
  }

  & a {
    scroll-snap-align: start;
    border-block-end: var(--indicator-size) solid hsl(var(--accent) / 0%);
    transition:
      color 0.7s ease,
      border-color 0.5s ease;

    display: inline-flex;
    align-items: center;
    white-space: nowrap;

    font-size: 0.8rem;
    color: var(--text-color);
    font-weight: bold;
    text-decoration: none;
    padding: var(--size-3) var(--size-5);

    & > svg {
      inline-size: 1.5em;
      pointer-events: none;
    }

    &:hover {
      background: hsl(var(--accent) / 5%);
    }

    &[active] {
      color: var(--text-active-color);
      border-block-end-color: hsl(var(--accent));
    }

    &:focus {
      outline-offset: -0.5ch;
    }
  }
}

snap-tabs > section > article {
  padding: var(--size-3) var(--size-5);
}
